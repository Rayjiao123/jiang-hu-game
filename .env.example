# Copy this file to .env and fill in your key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash


# Password for /admin.html (visitor numbers and conversations). Leave empty to switch the admin off; use a long random one in production.
ADMIN_PASSWORD=

# Spend protection: each model request counts as one call.
CALLS_PER_VISITOR_PER_10_MIN=150
DAILY_CALL_CAP=8000
