# Copy this file to .env and fill in your key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash

# Which places can be entered (comma-separated region ids from app/world.py). Everything else is "opens later".
OPEN_REGIONS=huashan

# Spend protection: each model request counts as one call.
CALLS_PER_VISITOR_PER_10_MIN=60
DAILY_CALL_CAP=3000
